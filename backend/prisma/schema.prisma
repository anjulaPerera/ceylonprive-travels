generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"

}

enum Role {
  ADMIN
  MANAGER
}

enum MediaType {
  IMAGE
  VIDEO
}

enum ContactStatus {
  PENDING
  VIEWED
  REPLIED
  CLOSED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  galleryItems       GalleryItem[]
  reviewTokens       ReviewToken[]
  contactSubmissions ContactSubmission[]

  @@map("users")
}

model GalleryItem {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  title        String
  description  String?
  cloudinaryId String    @unique @map("cloudinary_id")
  url          String
  thumbnailUrl String?   @map("thumbnail_url")
  mediaType    MediaType @map("media_type")
  category     String?
  isPublished  Boolean   @default(false) @map("is_published")
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isPublished, sortOrder])
  @@map("gallery_items")
}

model ReviewToken {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  token        String    @unique
  customerName String?   @map("customer_name")
  expiresAt    DateTime  @map("expires_at")
  usedAt       DateTime? @map("used_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review?

  @@index([token])
  @@map("review_tokens")
}

model Review {
  id            String    @id @default(uuid())
  reviewTokenId String    @unique @map("review_token_id")
  customerName  String    @map("customer_name")
  customerEmail String?   @map("customer_email")
  rating        Int
  title         String?
  body          String
  tourDate      DateTime? @map("tour_date")
  isApproved    Boolean   @default(false) @map("is_approved")
  isPublished   Boolean   @default(false) @map("is_published")
  tripAdvisorUrl String?  @map("tripadvisor_url")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  reviewToken ReviewToken @relation(fields: [reviewTokenId], references: [id], onDelete: Cascade)

  @@index([isPublished, isApproved])
  @@map("reviews")
}

model ContactSubmission {
  id            String        @id @default(uuid())
  userId        String?       @map("user_id")
  firstName     String        @map("first_name")
  lastName      String        @map("last_name")
  email         String
  phone         String?
  country       String?
  tripType      String?       @map("trip_type")
  groupSize     Int?          @map("group_size")
  preferredDate DateTime?     @map("preferred_date")
  duration      Int?
  budget        String?
  aiGeneratedPlan Json?       @map("ai_generated_plan")
  interests     String[]
  message       String?
  status        ContactStatus @default(PENDING)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("contact_submissions")
}